<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0"><%= filters.mine ? 'Mis videojuegos' : 'Colección' %></h2>
  <% if (currentUser) { %>
    <a class="btn btn-primary" href="/videojuegos/nuevo">+ Añadir</a>
  <% } %>
</div>

<form class="row g-2 mb-4" method="GET" action="/videojuegos">
  <div class="col-md-4">
    <input name="search" class="form-control" placeholder="Buscar por título o desarrollador"
           value="<%= filters.search %>">
  </div>
  <div class="col-md-3">
    <select name="genero" class="form-select">
      <option value="">Todos los géneros</option>
      <% generos.forEach(g => { %>
        <option <%= filters.genero === g ? 'selected' : '' %>><%= g %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-3">
    <select name="plataforma" class="form-select">
      <option value="">Todas las plataformas</option>
      <% plataformas.forEach(p => { %>
        <option <%= filters.plataforma === p ? 'selected' : '' %>><%= p %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-2 d-flex gap-2">
    <button class="btn btn-outline-light w-100">Filtrar</button>
    <% if (currentUser) { %>
      <a class="btn btn-outline-secondary" href="/videojuegos?<%= filters.mine ? '' : 'mine=1' %>"
         title="<%= filters.mine ? 'Ver todos' : 'Ver solo los míos' %>">
        <%= filters.mine ? 'Todos' : 'Míos' %>
      </a>
    <% } %>
  </div>
</form>

<% if (!items.length) { %>
  <div class="alert alert-secondary">No hay videojuegos que coincidan con los filtros.</div>
<% } else { %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    <% items.forEach(item => { %>
      <div class="col">
        <div class="card h-100 bg-dark border-secondary">
          <% if (item.imagen) { %>
            <img src="<%= item.imagen %>" class="card-img-top" style="height:180px;object-fit:cover"
                 alt="<%= item.titulo %>">
          <% } else { %>
            <div class="d-flex align-items-center justify-content-center bg-secondary bg-opacity-25"
                 style="height:180px">Sin portada</div>
          <% } %>
          <div class="card-body">
            <h5 class="card-title"><%= item.titulo %> <small class="text-secondary">(<%= item.anio %>)</small></h5>
            <p class="card-text small mb-1"><strong><%= item.plataforma %></strong> · <%= item.genero %></p>
            <p class="card-text small text-secondary mb-2"><%= item.desarrollador || '—' %></p>
            <p class="card-text mb-2">⭐ <%= item.rating %></p>
            <a href="/videojuegos/<%= item._id %>" class="btn btn-sm btn-outline-light">Ver detalle</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <nav class="mt-4">
    <ul class="pagination justify-content-center">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <% const qs = new URLSearchParams({
            page: i, limit,
            ...(filters.search && { search: filters.search }),
            ...(filters.genero && { genero: filters.genero }),
            ...(filters.plataforma && { plataforma: filters.plataforma }),
            ...(filters.mine && { mine: '1' })
        }).toString(); %>
        <li class="page-item <%= i === page ? 'active' : '' %>">
          <a class="page-link" href="/videojuegos?<%= qs %>"><%= i %></a>
        </li>
      <% } %>
    </ul>
  </nav>
<% } %>