<div class="row justify-content-center">
  <div class="col-md-5">
    <h2 class="mb-3">Crear cuenta</h2>
    <% if (errors.length) { %>
      <div class="alert alert-danger">
        <ul class="mb-0"><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul>
      </div>
    <% } %>
    <form method="POST" action="/auth/register">
      <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input name="nombre" class="form-control" value="<%= values.nombre || '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input name="email" type="email" class="form-control" value="<%= values.email || '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Contraseña (mín 8)</label>
        <input name="password" type="password" class="form-control" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Repite la contraseña</label>
        <input name="passwordConfirm" type="password" class="form-control" required>
      </div>
      <button class="btn btn-primary w-100">Registrarme</button>
    </form>
    <p class="text-center text-secondary mt-3">¿Ya tienes cuenta? <a href="/auth/login">Entra</a></p>
  </div>
</div>