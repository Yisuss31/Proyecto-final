<section class="card">
<div class="row justify-content-center">
  <div class="col-md-5">
    <h2 class="mb-3">Iniciar sesión</h2>
    <% if (errors.length) { %>
      <div class="alert alert-danger">
        <ul class="mb-0"><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul>
      </div>
    <% } %>
    <form method="POST" action="/auth/login">
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input name="email" type="email" class="form-control" value="<%= values.email || '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <input name="password" type="password" class="form-control" required>
      </div>
      <button class="btn btn-primary w-100">Entrar</button>
    </form>
    <p class="text-center text-secondary mt-3">¿Sin cuenta? <a href="/auth/register">Regístrate</a></p>
  </div>
</div>