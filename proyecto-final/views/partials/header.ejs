<header class="border-bottom border-secondary">
  <nav class="navbar navbar-expand-lg container">
    <a class="navbar-brand fw-bold" href="/">🎮 Arcade Vault</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="/videojuegos">Explorar</a></li>
        <% if (currentUser) { %>
          <li class="nav-item"><a class="nav-link" href="/videojuegos?mine=1">Mis juegos</a></li>
          <li class="nav-item"><a class="nav-link" href="/videojuegos/nuevo">+ Añadir</a></li>
        <% } %>
      </ul>
      <ul class="navbar-nav align-items-center">
        <% if (currentUser) { %>
          <li class="nav-item me-3">
            <span class="navbar-text small">
              <%= currentUser.nombre %>
              <% if (currentUser.rol === 'admin') { %>
                <span class="badge bg-warning text-dark">admin</span>
              <% } %>
            </span>
          </li>
          <li class="nav-item">
            <form action="/auth/logout" method="POST" class="d-inline">
              <button class="btn btn-outline-light btn-sm">Salir</button>
            </form>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
          <li class="nav-item"><a class="btn btn-primary btn-sm ms-2" href="/auth/register">Registro</a></li>
        <% } %>
      </ul>
    </div>
  </nav>
</header>